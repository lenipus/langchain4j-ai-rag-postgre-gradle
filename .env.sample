# 등록된 DB 연결의 비밀번호를 암호화하는 AES-256 키(Base64, 32바이트).
# 새 키 발행
#   PowerShell: $b=New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Git Bash(openssl): openssl rand -base64 32
SQLGEN_ENCRYPTION_KEY=
SQLGEN_FEATURE_ENABLED=